{
  "name": "maru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "commands:test": "node --env-file-if-exists=.env --import tsx src/register-commands.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "db:migrate:deploy": "node dist/migrate.js",
    "staff:setup": "node --env-file-if-exists=.env --import tsx src/setup-staff.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
