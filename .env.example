# Use a separate TEST bot application and a private test server.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=
# Set the private connection string supplied by your PostgreSQL host.
DATABASE_URL=
# Railway supplies PORT automatically. This is the local default.
PORT=3000

# Dashboard sign-in. Client secret is under OAuth2, not the Bot token.
APP_BASE_URL=https://maru-production-ae8c.up.railway.app
DISCORD_CLIENT_SECRET=

# Keep false until Server Members Intent is enabled for this bot in Discord.
# The dashboard's activity and role switches also default Off.
COMMUNITY_EVENTS_ENABLED=false
